# Required: WPGraphQL + WooGraphQL endpoint URL
NEXT_PUBLIC_GRAPHQL_URL=https://your-woocommerce-domain.com/graphql

# Required: WooCommerce REST API base URL
NEXT_PUBLIC_REST_URL=https://your-woocommerce-domain.com/wp-json/

# Optional: ISR revalidation interval in seconds (default: 60)
ISR_REVALIDATE_SECONDS=60

# Optional: Number of product slugs to pre-render at build time (default: 20)
STATIC_PRODUCT_LIMIT=20
